    <TR><TD BGCOLOR="#e9f0f8"><FONT POINT-SIZE="13"><B>SistemaReloj</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#41566c">Hereda de Morph</FONT></TD></TR>
    <HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#41566c" POINT-SIZE="9"><B>Variables de instancia</B></FONT><BR ALIGN="LEFT"/>coordinador<BR ALIGN="LEFT"/>ultimoTiempo</TD></TR>
    <HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#41566c" POINT-SIZE="9"><B>Variables de clase</B></FONT><BR ALIGN="LEFT"/><FONT COLOR="#526476"><I>Ninguna</I></FONT></TD></TR>
    <HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#41566c" POINT-SIZE="9"><B>Métodos de instancia</B></FONT><BR ALIGN="LEFT"/>configurarCoordinador:<BR ALIGN="LEFT"/>detener<BR ALIGN="LEFT"/>iniciar<BR ALIGN="LEFT"/>montarEn:posicion:<BR ALIGN="LEFT"/>step<BR ALIGN="LEFT"/>stepTime<BR ALIGN="LEFT"/>wantsSteps</TD></TR>
    <HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#41566c" POINT-SIZE="9"><B>Métodos de clase</B></FONT><BR ALIGN="LEFT"/><FONT COLOR="#526476"><I>Ninguno</I></FONT></TD></TR>
  </TABLE>>];

  // El rombo relleno se sitúa del lado del objeto que contiene al componente.
  edge [dir=back, arrowtail=diamond, arrowhead=none];
  AplicacionJuego -> CoordinadorPartida;
  CoordinadorPartida -> SistemaControles;
  CoordinadorPartida -> SistemaEscenario;
  CoordinadorPartida -> SistemaReloj;
  SistemaControles -> EntradaControles;
  SistemaEscenario -> EntradaEscenario;
  Juego -> Personaje [headlabel="1", labeldistance=1.6, labelangle=-35];
  Juego -> Obstaculo [headlabel="0..*", labeldistance=1.6, labelangle=-30];
  Juego -> Moneda [headlabel="0..*", labeldistance=1.6, labelangle=-35];

  // La asociación representa una referencia conservada en una variable de instancia.
  edge [dir=forward, arrowtail=none, arrowhead=vee];
  SistemaControles -> PanelControles;
  SistemaEscenario -> PanelEscenario;
  SistemaEscenario -> Juego;

  // Las dependencias representan uso sin una referencia de instancia propia.
  edge [style=dashed, arrowhead=vee, color="#657487", constraint=false];
  Juego -> Pajaro [label="crea"];
  Obstaculo -> Personaje [label="consulta límites"];

  // El triángulo hueco apunta a la superclase.
  edge [style=solid, color="#435365", arrowhead=onormal];
  Pajaro -> Obstaculo;
  Moneda -> Obstaculo;

  {rank=same; AplicacionJuego; CoordinadorPartida}
  {rank=same; SistemaControles; SistemaEscenario; SistemaReloj}
  {rank=same; EntradaControles; PanelControles; EntradaEscenario; PanelEscenario; Juego}
  {rank=same; Personaje; Obstaculo; Moneda; Pajaro}
  edge [style=invis, constraint=true, weight=10];
  SistemaControles -> SistemaEscenario -> SistemaReloj;
  EntradaControles -> PanelControles -> EntradaEscenario -> PanelEscenario -> Juego;
  Personaje -> Obstaculo -> Moneda -> Pajaro;

  subgraph cluster_leyenda {
    graph [label="Relaciones UML", fontname="Arial", fontsize=12, style=rounded, color="#b1bac5", margin=12];
    node [shape=plain, style="", fontname="Arial", fontsize=10];
    composicion [label="Composición"];
    asociacion [label="Asociación"];
    dependencia [label="Dependencia"];
    herencia [label="Herencia"];
    node [shape=point, width=0.015, height=0.015, fixedsize=true, label="", style=invis];
    edge [style=solid, constraint=true, weight=1, arrowtail=none, arrowhead=vee];
    {rank=same; c; composicion; a; asociacion; d; dependencia; h; herencia}
    c -> composicion [dir=back, arrowtail=diamond, arrowhead=none];
    a -> asociacion;
    d -> dependencia [style=dashed];
    h -> herencia [arrowhead=onormal];
    composicion -> a [style=invis];
    asociacion -> d [style=invis];
    dependencia -> h [style=invis];
  }
  Obstaculo -> c [style=invis];
}
